# ==============================================================================
# Standalone PostgreSQL & Application Configuration
# Note: Firebase is NOT used. All persistence runs on standalone PostgreSQL.
# ==============================================================================

# Server-only PostgreSQL direct connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/cms_admin?schema=public"

# Database Configuration (for standalone local PostgreSQL daemon)
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="cms_admin"

# Session Security & Cryptography
# 64+ char random hexadecimal or base64 secret string for signing cookies and tokens
SESSION_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS"

# Administrator Bootstrap Credentials (used strictly for first-time seeding)
# Once seeded, passwords are stored exclusively as Argon2id hashes.
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD"

# Environment Mode
NODE_ENV="development"

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
